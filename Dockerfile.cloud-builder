# ==============================================
# CodeVault Cloud Builder - Pre-built Docker Image
# ==============================================
# This image contains all dependencies pre-installed for faster Cloud Build runs.
#
# Build and push to GCR (when Docker is running):
#   gcloud auth configure-docker gcr.io
#   docker build -t gcr.io/cloudbuild-486309/codevault-builder:latest -f Dockerfile.cloud-builder .
#   docker push gcr.io/cloudbuild-486309/codevault-builder:latest
#
# Expected savings: 2-3 minutes per build (no apt-get/pip install)
#
# To use in cloudbuild.yaml, replace:
#   name: 'python:3.11-slim'
# with:
#   name: 'gcr.io/cloudbuild-486309/codevault-builder:latest'

FROM python:3.11-slim

LABEL maintainer="CodeVault Team"
LABEL description="Pre-built image for CodeVault Cloud Build with Nuitka and dependencies"
LABEL version="3.0"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CCACHE_DIR=/workspace/.ccache \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NUITKA_CACHE_DIR=/workspace/.nuitka-cache

# Install system dependencies in single layer
# Note: python3-dev is needed for compiling C extensions (use python3-full for better compatibility)
RUN apt-get update && apt-get install -y --no-install-recommends \
    patchelf \
    build-essential \
    ccache \
    unzip \
    curl \
    zip \
    tar \
    python3-tk \
    python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Pre-install Python build dependencies (major time saver)
# Pinning Nuitka to 2.4.8 for stability
RUN pip install --no-cache-dir \
    nuitka==2.4.8 \
    ordered-set \
    zstandard \
    requests \
    cryptography \
    pefile

# Pre-configure ccache
RUN mkdir -p /workspace/.ccache /workspace/.nuitka-cache /workspace/artifacts && \
    ccache --set-config=max_size=500M

WORKDIR /workspace

CMD ["python3", "--version"]