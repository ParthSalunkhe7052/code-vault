#!/bin/bash
# CodeVault CLI Launcher for Unix/Linux/macOS
# 
# Usage: ./codevault [command] [options]

set -e

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_DIR="$SCRIPT_DIR/cli"

# Check if CLI directory exists
if [ ! -d "$CLI_DIR" ]; then
    echo "[ERROR] CLI directory not found: $CLI_DIR"
    exit 1
fi

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo "[ERROR] Python 3 is not installed or not in PATH"
    echo "Please install Python from https://python.org"
    exit 1
fi

# Change to CLI directory
cd "$CLI_DIR"

# Check if new CLI exists and run it
if [ -f "codevault_cli/app.py" ]; then
    python3 -m codevault_cli "$@"
else
    # Fallback to legacy CLI
    echo "[INFO] Running legacy CLI..."
    python3 "lw_compiler.py" "$@"
fi
