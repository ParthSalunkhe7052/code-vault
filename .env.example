# ===========================================
# License-Wrapper Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Server Mode
MODE=production

# Database - Supabase PostgreSQL
# Get these from: Supabase Dashboard → Connect → Connection pooling
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Security Keys (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ============================================
# Cloud Build Configuration (GitHub Actions)
# ============================================
# GitHub Personal Access Token with 'repo' and 'workflow' permissions
GITHUB_TOKEN=ghp_your_github_token_here

# Your GitHub repository in format: owner/repo-name
GITHUB_REPO=ParthSalunkhe7052/code-vault

# Secret for webhook HMAC verification (generate with: openssl rand -hex 32)
BUILD_CALLBACK_SECRET=your_callback_secret_here

# Public URL for webhook callbacks (use ngrok for local dev)
# Run: ngrok http 8000 → copy the https URL
PUBLIC_API_URL=https://your-ngrok-url.ngrok-free.app

# Upstash Redis (for rate limiting/caching)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Email Configuration
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=CodeVault
EMAIL_SALES=sales@your-domain.com
EMAIL_SUPPORT=support@your-domain.com
EMAIL_ENTERPRISE=enterprise@your-domain.com

# Admin Email (for admin role assignment)
ADMIN_EMAIL=admin@your-domain.com

# Polar Payment Configuration
# Get your access token from https://polar.sh/settings
POLAR_ACCESS_TOKEN=polar_oat_your_access_token_here

# Polar Product IDs (from your Polar Dashboard)
POLAR_PRODUCT_PRO=your_pro_product_id
POLAR_PRODUCT_BUSINESS=your_business_product_id

# Polar Webhook Secret (set after creating webhook endpoint in Polar Dashboard)
POLAR_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Cloud Build
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUILDS_BUCKET=codevault-builds

# File Upload Limits (optional - defaults shown)
# MAX_FILE_SIZE=104857600          # 100MB per file
# MAX_ZIP_SIZE=524288000           # 500MB for ZIP uploads
# MAX_TOTAL_PROJECT_SIZE=524288000 # 500MB total per project
