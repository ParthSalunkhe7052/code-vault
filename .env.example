# ===========================================
# License-Wrapper Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Server Mode
MODE=production

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Security Keys (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ============================================
# Cloud Build Configuration (GitHub Actions)
# ============================================
# GitHub Personal Access Token with 'repo' and 'workflow' permissions
GITHUB_TOKEN=ghp_your_github_token_here

# Your GitHub repository in format: owner/repo-name
GITHUB_REPO=ParthSalunkhe7052/code-vault

# Secret for webhook HMAC verification (generate with: openssl rand -hex 32)
BUILD_CALLBACK_SECRET=your_callback_secret_here

# Public URL for webhook callbacks (use ngrok for local dev)
# Run: ngrok http 8000 → copy the https URL
PUBLIC_API_URL=https://your-ngrok-url.ngrok-free.app

# Upstash Redis (for rate limiting/caching)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Resend Email
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=CodeVault

# Admin Email (for admin role assignment)
ADMIN_EMAIL=admin@your-domain.com

# Stripe API Keys (TEST MODE)
# Switch to sk_live_... and pk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs (from your Stripe Dashboard Products)
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id

# Stripe Webhook Secret (set this after creating webhook in Stripe Dashboard)
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# File Upload Limits (optional - defaults shown)
# MAX_FILE_SIZE=104857600          # 100MB per file
# MAX_ZIP_SIZE=524288000           # 500MB for ZIP uploads
# MAX_TOTAL_PROJECT_SIZE=524288000 # 500MB total per project
